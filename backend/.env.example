# All values below are server-side only. This file must never reach the browser.
# Copy it to `.env.local` and fill in real values locally; `.env.local` is git-ignored.

# PostgreSQL connection string (Phase 4 - not used yet, declared for setup completeness).
# Nothing in Phase 3 connects to a database; `GET /api/health` deliberately does
# not report database health.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/krishi_mandi?schema=public"

# Comma-separated allowlist of browser origins permitted to call this API.
#
# This is REQUIRED in production. Entries must be full origins with no path,
# for example "http://localhost:5173,https://app.example.com".
# Wildcards ("*") and the value "null" are rejected on purpose, and the policy
# also sends Access-Control-Allow-Credentials, which forbids "*" anyway.
#
# Behaviour when this variable is missing:
#   - `next dev` (NODE_ENV=development): falls back to http://localhost:5173 so
#     the documented two-terminal setup works with no extra setup.
#   - `next start` (NODE_ENV=production): the allowlist is EMPTY, so every
#     cross-origin request is rejected with 403. This fails closed on purpose.
# Requests without an Origin header (curl, server-to-server, same-origin) are
# never affected by this list.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Mandi price data provider mode: "demo" (default, deterministic seeded data) or "live".
# "live" stays disabled until a real provider is verified. See PRD section 16.
MANDI_DATA_PROVIDER_MODE=demo

# Optional. Official mandi data provider API key. Leave blank while in "demo" mode.
MANDI_PROVIDER_API_KEY=

# Optional. AI provider credentials used only to explain already-computed results.
# Leave blank to use the deterministic rule-based fallback (the MVP default).
AI_API_KEY=
AI_MODEL=
